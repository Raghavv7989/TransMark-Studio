# ==============================================================================
# TransMark Studio — Production AI Environment Configuration
# ==============================================================================

# Server & Runtime Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
PROJECT_NAME="TransMark AI Dubbing Platform"

# 1. Isochronic LLM Dialogue Translation (Telugu, Hindi, Tamil, Spanish, etc.)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=auto
DEFAULT_TARGET_LANGUAGE=te
SYLLABLE_TOLERANCE_MARGIN=0.10

# 2. Precision ASR & Acoustic Alignment (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
PAUSE_THRESHOLD_MS=300

# 3. Zero-Shot Voice Cloning & Audio Alignment
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_BACKEND=auto
TTS_SAMPLE_RATE=44100
BACKGROUND_MIX_VOLUME=0.70

# 4. Zero-Damage Neural Lip-Sync & Face Restoration (MuseTalk / CodeFormer)
SYNCLABS_API_KEY=your_synclabs_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here
LIPSYNC_ENGINE=musetalk
FACE_RESTORATION=codeformer
MOUTH_FEATHER_RADIUS=15
POISSON_BLENDING=true

# 5. Audio Demuxing (Demucs)
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=auto
FORCE_FFMPEG_FALLBACK=false
