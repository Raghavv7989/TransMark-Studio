*.gz
*.zip
*.7z

# Local Media Storage Directories (Preserve directory structure via .gitkeep)
backend/app/storage/raw/*
!backend/app/storage/raw/.gitkeep
backend/app/storage/audio_segments/*
!backend/app/storage/audio_segments/.gitkeep
backend/app/storage/video_frames/*
!backend/app/storage/video_frames/.gitkeep
backend/app/storage/outputs/*
!backend/app/storage/outputs/.gitkeep
backend/app/storage/master_verification_output/
backend/app/storage/reels_verification/
backend/app/storage/live_production_test/
backend/app/storage/test_full_verification/
backend/app/storage/test_verification/
backend/app/storage/*.mp3
backend/app/storage/*.wav
backend/app/storage/*.mp4
backend/app/storage/*.json

